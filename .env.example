# Copy to .env for local development (npm run dev). On Vercel, add these
# under Project Settings -> Environment Variables instead.

# Required for real AI lessons
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# LESSON_MODEL=claude-opus-5
# LESSON_EFFORT=medium
# EXPLAIN_MODEL=claude-opus-5
# EXPLAIN_EFFORT=low

# Set to 1 to serve built-in demo lessons without calling the API
# MOCK_AI=1
